<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calling_point_layout"
    android:layout_width="match_parent"
    android:layout_height="80dp">

    <View
        android:id="@+id/line_1"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginStart="100dp"
        android:background="@color/visited"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/line_2"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:layout_marginStart="100dp"
        android:background="@color/to_visit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/circle" />

    <View
        android:id="@+id/circle"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="92dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/filled_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/calling_point_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="19dp"
        android:text="10:14"
        android:textColor="@color/main_text"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/calling_point_status"
        android:layout_width="66dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:text="Departed On Time"
        android:textColor="@color/on_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/calling_point_time" />

    <TextView
        android:id="@+id/calling_point_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:text="Paigton"
        android:textColor="@color/main_text"
        android:textSize="18sp"
        app:layout_constraintStart_toEndOf="@+id/circle"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/calling_point_platform"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Platform 2"
        android:textColor="@color/secondary_text"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/circle"
        app:layout_constraintTop_toBottomOf="@+id/calling_point_name" />
</androidx.constraintlayout.widget.ConstraintLayout>